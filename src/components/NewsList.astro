---
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDate = (date: Date) =>
  date.toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo', year: 'numeric', month: '2-digit', day: '2-digit' });
---
{entries.length > 0 && (
  <section class="news">
    <h2>お知らせ</h2>
    <ul class="news-list">
      {entries.map(async (entry) => {
        const { Content } = await render(entry);
        return (
          <li>
            <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
            <strong>{entry.data.title}</strong>
            <div class="news-body"><Content /></div>
          </li>
        );
      })}
    </ul>
  </section>
)}
