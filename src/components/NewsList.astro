---
import { getCollection, render } from 'astro:content';
import { showDrafts } from '../lib/drafts';

// draft: true のお知らせは公開サイトに出さず、開発サーバー（npm run dev）でだけ「下書き」として表示する
const entries = (await getCollection('news', ({ data }) => showDrafts || !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDate = (date: Date) =>
  date.toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo', year: 'numeric', month: '2-digit', day: '2-digit' });
---
{entries.length > 0 && (
  <section class="news">
    <h2>お知らせ</h2>
    <ul class="news-list">
      {entries.map(async (entry) => {
        const { Content } = await render(entry);
        return (
          <li class:list={[{ 'news-draft': entry.data.draft }]}>
            <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
            {entry.data.draft && <span class="news-draft-badge">下書き</span>}
            <strong>{entry.data.title}</strong>
            <div class="news-body"><Content /></div>
          </li>
        );
      })}
    </ul>
  </section>
)}
