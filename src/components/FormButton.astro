---
// Googleフォームなど外部フォームを別タブで開くボタン。
// スマホで埋め込み（iframe）だとスクロールがぶつかって入力しにくいため、別タブで開く。
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---
<p class="form-button">
  <a class="button button--primary" href={href} target="_blank" rel="noopener">
    {label}
    <svg class="button-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/></svg>
  </a>
  <span class="form-button-note">Googleフォームが別タブで開きます</span>
</p>
