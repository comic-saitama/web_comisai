---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import EntryBanner from './EntryBanner.astro';
import { event } from '../data/site';
import { formatMonthDay, formatWeekday } from '../lib/date';
import { url } from '../lib/url';

// 日程が決まっていれば日付、未定なら開催時期を表示する
const first = event.dates.at(0);
const last = event.dates.at(-1);
const entryOpen = event.entry.status === 'open' && event.entry.formUrl;
---
<section class="hero" aria-labelledby="hero-title">
  <EntryBanner />
  <div class="hero-inner">
    <p class="hero-tagline">{event.tagline}</p>
    <h1 id="hero-title" class="hero-title">
      <Image src={logo} alt={event.name} widths={[360, 720]} sizes="(max-width: 480px) 80vw, 360px" loading="eager" fetchpriority="high" />
    </h1>
    <dl class="hero-info">
      <div>
        <dt>{first ? '開催日' : '開催時期'}</dt>
        {first && last ? (
          <dd>
            <span class="hero-year">{first.slice(0, 4)}</span>
            {formatMonthDay(first)}<small>({formatWeekday(first)})</small>
            {last !== first && (
              <>
                <span class="hero-sep">–</span>
                {formatMonthDay(last)}<small>({formatWeekday(last)})</small>
              </>
            )}
          </dd>
        ) : (
          <dd>
            {event.period}
            <small class="hero-note">日程は決定し次第お知らせします</small>
          </dd>
        )}
      </div>
      <div>
        <dt>会場</dt>
        <dd>
          {event.venue}
          {event.venueNote && <small class="hero-note">{event.venueNote}</small>}
        </dd>
      </div>
    </dl>
    <div class="hero-actions">
      {entryOpen ? (
        <a class="button button--primary" href={event.entry.formUrl} target="_blank" rel="noopener">サークル参加を申し込む</a>
      ) : (
        <a class="button button--primary" href={url('/pages/services.html')}>参加詳細を見る</a>
      )}
      <a class="button button--secondary" href={url('/pages/recruit.html')}>スタッフ募集中！</a>
    </div>
  </div>
</section>
