---
// 参加詳細ページの募集要項欄。participation.published が false の間は npm run dev でだけ下書きとして表示する。
import { participation } from '../data/participation';
import { event } from '../data/site';
import { showDrafts } from '../lib/drafts';
import DraftBanner from './DraftBanner.astro';
import FormButton from './FormButton.astro';
import SpecList from './SpecList.astro';

const visible = participation.published || showDrafts;
const entryOpen = event.entry.status === 'open' && event.entry.formUrl;
---
{visible && (
  <section class="participation" aria-label="募集要項">
    {!participation.published && (
      <DraftBanner issue={14}>
        この募集要項欄は <code>npm run dev</code> でだけ表示され、公開サイトには出力されません。「未定」の項目を
        <code>src/data/participation.ts</code> で埋め、<code>published: true</code> にすると公開されます。
      </DraftBanner>
    )}

    <h2 id="schedule">スケジュール</h2>
    <SpecList items={participation.schedule} />

    <h2 id="circle">サークル参加の募集要項</h2>
    <SpecList items={participation.circle} />
    {entryOpen && <FormButton href={event.entry.formUrl} label="サークル参加を申し込む" />}

    <h2 id="consignment">委託参加の募集要項</h2>
    <SpecList items={participation.consignment} />

    <h2 id="guidelines">頒布物のルール</h2>
    <SpecList items={participation.guidelines} />
  </section>
)}
