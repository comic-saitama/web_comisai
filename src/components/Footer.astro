---
import { site } from '../data/site';
import XIcon from './XIcon.astro';
import DiscordIcon from './DiscordIcon.astro';
import { showDrafts } from '../lib/drafts';
import { url } from '../lib/url';
---
<footer>
  <div class="footer-content">
    <div class="contact-info">
      <div class="email-link">
        <a href={`mailto:${site.email}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6zm-2 0l-8 5-8-5h16zm0 12H4V8l8 5 8-5v10z"/>
          </svg>
          <span>{site.email}</span>
        </a>
      </div>
      <div class="social-links">
        <a href={site.x.url} target="_blank" rel="noopener" aria-label="X (formerly Twitter)">
          <XIcon />
          <span>@{site.x.handle}</span>
        </a>
      </div>
      {site.discord.inviteUrl && (
        <div class="social-links">
          <a href={site.discord.inviteUrl} target="_blank" rel="noopener">
            <DiscordIcon />
            <span>Discordサーバー</span>
          </a>
        </div>
      )}
    </div>
    {showDrafts && (
      <p class="footer-links"><a href={url('/pages/policy.html')}>個人情報の取り扱い</a></p>
    )}
    <p class="copyright">Copyright &copy; 2026 {site.copyrightHolder} All Rights Reserved</p>
  </div>
</footer>
