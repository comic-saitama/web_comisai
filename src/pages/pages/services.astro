---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import Follow from '../../components/Follow.astro';
import ParticipationDetails from '../../components/ParticipationDetails.astro';
---
<BaseLayout
  title="参加詳細"
  description="サークル参加、委託参加、一般参加の方法についてのご案内です。募集要項やスケジュールは決定次第更新します。"
>
  <h1>参加詳細</h1>
  <p>
    募集要項・日程は決定し次第、本ページやX(<a href={site.x.url} target="_blank" rel="noopener">@{site.x.handle}</a>)等で順次ご案内します。下記のいずれかで最新情報を受け取れます。
  </p>

  <ParticipationDetails />

  <Follow />
</BaseLayout>
